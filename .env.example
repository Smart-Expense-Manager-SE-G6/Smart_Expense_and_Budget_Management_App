# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_IDLE_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO
# Rate limits (DRF format: N/sec|min|hour|day)
LOGIN_RATE_LIMIT=10/min
REGISTER_RATE_LIMIT=5/min
# Failed logins allowed per window: per (account, IP), and per account from all IPs
LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_FAILURES_PER_ACCOUNT_AND_IP=5
LOGIN_FAILURES_PER_ACCOUNT=25
# Devices that logged in successfully may pass the account-wide cap for this long
TRUSTED_DEVICE_MAX_AGE_SECONDS=7776000
# Trusted reverse proxies in front of Django (0 in dev; 1 behind nginx etc. in production)
NUM_PROXIES=0

# PostgreSQL
POSTGRES_DB=smart_expense
POSTGRES_USER=smart_expense
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backups (docker compose "backup" service, scripts/)
# When to back up: a cron expression in UTC. 02:00 UTC is 07:30 IST.
BACKUP_SCHEDULE="0 2 * * *"
# How many scheduled backups to keep
BACKUP_KEEP=7
