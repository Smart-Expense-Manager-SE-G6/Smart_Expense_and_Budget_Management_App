# Coverage settings shared by CI and local runs (S3-11).
#   cd backend && coverage run manage.py test && coverage report
[run]
branch = True
source = .
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */tests/*
    manage.py
    config/asgi.py
    config/wsgi.py

[report]
show_missing = True
skip_covered = True
sort = Cover
# Line and branch coverage combined; CI fails below this.
fail_under = 80
