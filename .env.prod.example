# Production settings (S3-10). Copy to .env.prod and fill in; never commit .env.prod.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# Public domain of the site. Caddy gets the HTTPS certificate for it automatically.
# Point the domain's DNS A record at the server first. No domain? Use the server's
# public IP with sslip.io, e.g. 203-0-113-10.sslip.io
SITE_ADDRESS=smartexpense.example.com
ACME_EMAIL=team6@example.com

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=smartexpense.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://smartexpense.example.com
SESSION_IDLE_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

POSTGRES_DB=smart_expense
POSTGRES_USER=smart_expense
POSTGRES_PASSWORD=replace-with-a-long-random-string

# Alert emails (FR18), e.g. Brevo's free SMTP relay.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@smartexpense.example.com

BACKUP_SCHEDULE="0 2 * * *"
BACKUP_KEEP=7

# Encrypted off-site copies (S3-18). OFFSITE_PATH is a folder on the VM where cloud
# storage is mounted (Azure Files share or S3 bucket); see docs/recovery-runbook.md.
# Keep BACKUP_PASSPHRASE somewhere safe outside the server: without it the off-site
# copies cannot be decrypted.
OFFSITE_PATH=/mnt/offsite
OFFSITE_KEEP=7
BACKUP_PASSPHRASE=replace-with-a-long-random-passphrase
# Weekly restore rehearsal (cron, UTC). Sunday 03:30 by default.
REHEARSAL_SCHEDULE="30 3 * * 0"
